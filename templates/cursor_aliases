cursor-info() {
    echo "=== Cursor Agent Status ==="
    cursor agent status
    echo ""
    echo "=== MCP Servers ==="
    cursor agent mcp list 2>/dev/null || echo "No MCP servers configured"
    echo ""
    echo "=== Recent Sessions ==="
    cursor agent ls 2>/dev/null | head -10 || echo "No sessions found"
}
